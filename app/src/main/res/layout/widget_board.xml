            <TextView android:id="@+id/bsub_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textColor="@color/widget_text_secondary" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:gravity="end" android:orientation="vertical">
            <TextView android:id="@+id/bmins_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:textColor="@color/widget_text" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/bleave_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:textColor="@color/widget_leave" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/brow_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <TextView android:id="@+id/bbadge_2" android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/badge_round_0" android:gravity="center" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
